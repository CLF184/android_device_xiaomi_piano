Build Android gdisk and backport its k command from GPT fdisk 1.0.10.

Base: AOSP android-16.0.0_r1, commit 80eee0e7ee4ddebc6b5948d8eb555d356ac00f58.
The existing j command is retained; k uses upstream MoveSecondTable and its
interactive default so the Nabu x/j/k/w sequence works on 4096-byte sectors.

diff --git a/Android.bp b/Android.bp
index c1894e9..d8bf0f4 100644
--- a/Android.bp
+++ b/Android.bp
@@ -64,6 +64,32 @@ cc_binary {
     ],
 }
 
+// Interactive gdisk is needed by the upstream x/j/k/w fixgpt sequence.
+// Compile the existing Android sources and the 1.0.10 k-command backport.
+cc_binary {
+    name: "gdisk",
+    defaults: ["gptfdisk_default_flags"],
+    recovery: true,
+    srcs: [
+        "gdisk.cc",
+        "gpttext.cc",
+        "crc32.cc",
+        "support.cc",
+        "guid.cc",
+        "gptpart.cc",
+        "mbrpart.cc",
+        "basicmbr.cc",
+        "mbr.cc",
+        "gpt.cc",
+        "bsd.cc",
+        "parttypes.cc",
+        "attributes.cc",
+        "diskio.cc",
+        "diskio-unix.cc",
+    ],
+    shared_libs: ["libext2_uuid"],
+}
+
 lib_common_srcs = [
     "gptcl.cc",
     "crc32.cc",
diff --git a/gpt.cc b/gpt.cc
