+#ifndef BUILD_TWRPTAR_MAIN
+// MSC implementation from ArKT-7/twrp_device_xiaomi_nabu, commit 9bf1fd3.
+static void FlushBlockDeviceByArKT(const std::string& dev) {
+    if (!dev.empty()) {
+        int fd = open(dev.c_str(), O_RDONLY);
+        if (fd >= 0) {
+            ioctl(fd, BLKFLSBUF, 0);
+            close(fd);
+        }
+    }
+}
+
+static void ForceUnmountByArKT(const std::string& path) {
+    TWPartition* part = PartitionManager.Find_Partition_By_Path(path);
+    std::string actual_block;
+    if (part) {
+        actual_block = part->Actual_Block_Device;
+        if (!actual_block.empty()) {
+            FlushBlockDeviceByArKT(actual_block);
+        }
+        part->UnMount(false);
+    } else {
+        PartitionManager.UnMount_By_Path(path, false);
+    }
+    umount2(path.c_str(), 0);
+    if (!actual_block.empty()) {
+        TWFunc::Exec_Cmd("umount " + actual_block + " >/dev/null 2>&1 || true");
+    }
+    if (path == "/win" || path == "/esp" || path == "/metadata" || path == "/userdata") {
+        TWFunc::Exec_Cmd("umount /dev/block/bootdevice/by-name" + path + " >/dev/null 2>&1 || true");
+    }
+}
+
+bool TWFunc::CommonByArKT()
+{
+    std::string usb_config = android::base::GetProperty("sys.usb.config", "");
+    if (usb_config.find("mtp") != std::string::npos) {
+        gui_print("\nMTP mode detected, resetting USB to ADB...");
+        PartitionManager.Disable_MTP();
+        android::base::SetProperty("sys.usb.config", "none");
+        android::base::SetProperty("sys.usb.config", "adb");
+        Exec_Cmd("rm -f /config/usb_gadget/g1/configs/b.1/f* || true");
+        std::this_thread::sleep_for(std::chrono::milliseconds(500));
+    }
+
+    gui_print("\nUnmounting all required partitions...");
+    sync();
+    if (Exec_Cmd("sh /piano/bin/piano-msc-prepare.sh") != 0) {
+        gui_print("\nMSC preparation failed. Reboot Recovery before retrying.\n");
+        return false;
+    }
+
+    ForceUnmountByArKT("/win");
+    ForceUnmountByArKT("/esp");
+
+    std::vector<PartitionList> mountable_parts;
+    PartitionManager.Get_Partition_List("mount", &mountable_parts);
+
+    for (const PartitionList& list_part : mountable_parts) {
+        TWPartition* part = PartitionManager.Find_Partition_By_Path(list_part.Mount_Point);
+        if (part == nullptr) continue;
+
+        const std::string mp = part->Get_Mount_Point();
+        if (mp == "/data" || mp == "/sdcard" || mp == "/metadata" || mp == "/win" || mp == "/esp") continue;
+
+        if (part->Actual_Block_Device.find("sda") != std::string::npos ||
+            part->Actual_Block_Device.find("bootdevice") != std::string::npos ||
+            part->Get_Super_Status()) {
+            ForceUnmountByArKT(mp);
+        }
+    }
+    sync();
+    FlushBlockDeviceByArKT("/dev/block/sda");
+    return true;
+}
+
+void TWFunc::MscByArKT()
+{
+    static std::atomic<bool> starting(false);
+    if (starting.exchange(true)) return;
+    DataManager::SetValue(TW_ACTION_BUSY, 1);
+
+    std::thread([] {
+        gui_print("\nEnabling Mass Storage Mode!\n\n");
+        if (!CommonByArKT()) {
+            DataManager::SetValue(TW_ACTION_BUSY, 0);
+            starting = false;
+            return;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(500));
+
+        const std::string msc_script = R"ArKT(
+            set -e
+            g=/config/usb_gadget/g1
+            trap 'status=$?; if [ "$status" -ne 0 ]; then
+                set +e
+                if [ -n "$(cat "$g/UDC")" ]; then echo "" > "$g/UDC"; fi
+                rm -f "$g/configs/b.1/mass_storage.0"
+                echo "" > "$g/functions/mass_storage.0/lun.0/file"
+                setprop sys.usb.config adb
+            fi' EXIT
+            setprop sys.usb.config none
+            retries=0
+            while [ "$(getprop sys.usb.state)" != none ]; do
+                retries=$((retries + 1))
+                [ "$retries" -lt 50 ] || exit 1
+                sleep 0.1
+            done
+            if [ -n "$(cat "$g/UDC")" ]; then echo "" > "$g/UDC"; fi
+            setenforce 0
+            echo 0x2717 > "$g/idVendor"
+            echo 0x9039 > "$g/idProduct"
+            echo 0xEF > "$g/bDeviceClass"
+            echo 0x02 > "$g/bDeviceSubClass"
+            echo 0x01 > "$g/bDeviceProtocol"
+            mkdir -p "$g/functions/mass_storage.0"
+            echo 0 > "$g/functions/mass_storage.0/lun.0/ro"
+            echo 0 > "$g/functions/mass_storage.0/lun.0/removable"
+            echo /dev/block/sda > "$g/functions/mass_storage.0/lun.0/file"
+            ln -s "$g/functions/mass_storage.0" "$g/configs/b.1/mass_storage.0"
+            setprop ctl.start adbd
+            retries=0
+            while [ "$(getprop sys.usb.ffs.ready)" != 1 ]; do
+                retries=$((retries + 1))
+                [ "$retries" -lt 50 ] || exit 1
+                sleep 0.1
+            done
+            ln -s "$g/functions/ffs.adb" "$g/configs/b.1/f1"
+            echo a600000.dwc3 > "$g/UDC"
+        )ArKT";
+
+        if (Exec_Cmd(msc_script) == 0)
+            gui_print("\nDone! Reboot Recovery after using mass storage.\n");
+        else
+            gui_print("\nMSC USB setup failed. Reboot Recovery before retrying.\n");
+        DataManager::SetValue(TW_ACTION_BUSY, 0);
+        starting = false;
+    }).detach();
+}
+#endif
