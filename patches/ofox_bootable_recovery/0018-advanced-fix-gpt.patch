+int GUIAction::fixgpt(std::string arg __unused)
+{
+  operation_start("Fix GPT");
+  int op_status = 1;
+  if (simulate) {
+    simulate_progress_bar();
+    op_status = 0;
+  } else if (access(ARKT_MSC_MARKER_PATH, F_OK) == 0) {
+    gui_print("\nMass storage is enabled. Reboot Recovery before fixing GPT.\n");
+  } else if (access("/system/bin/gdisk", X_OK) != 0) {
+    gui_print("\ngdisk is unavailable. GPT was not changed.\n");
+  } else if (TWFunc::CommonByArKT() && PartitionManager.Unmap_Super_Devices()) {
+    // Match the Nabu common preparation after releasing piano's secure stack.
+    const std::string prepare = R"FixGPT(
+if [ -b /dev/block/mapper/userdata ]; then
+    dmctl delete userdata || exit 1
+fi
+while read -r source target rest; do
+    case "$source" in /dev/block/*) umount "$target" || exit 1 ;; esac
+done < /proc/mounts
+sync
+)FixGPT";
+    if (TWFunc::Exec_Cmd(prepare) == 0) {
+      bool found = false;
+      op_status = 0;
+      for (char suffix = 'a'; suffix <= 'f'; ++suffix) {
+        const std::string device = std::string("/dev/block/sd") + suffix;
+        struct stat st;
+        if (stat(device.c_str(), &st) != 0 || !S_ISBLK(st.st_mode))
+          continue;
+        found = true;
+        gui_print("\nFixing GPT on %s...\n", device.c_str());
+        std::string output;
+        const int result = TWFunc::Exec_Cmd(
+          "printf 'x\\nj\\n\\nk\\n\\nw\\nY\\n' | /system/bin/gdisk " + device,
+          output, true);
+        gui_print("%s", output.c_str());
+        if (result != 0 || output.find("The operation has completed successfully.") == std::string::npos)
+          op_status = 1;
+      }
+      if (!found)
+        op_status = 1;
+      sync();
+    } else {
+      gui_print("\nUnable to release mounted partitions. GPT was not changed.\n");
+    }
+    gui_print("\nReboot Recovery before mounting partitions or using mass storage.\n");
+  }
+  operation_end(op_status);
+  return 0;
+}
+
 int GUIAction::fixpermissions(std::string arg)
 {
